require(stringi)
require(dplyr)
require(tidyr)
require(ggplot2)
require(zoo)
options(pillar.sigfig = 7)
przelewy24 <- NULL
files <- list.files("~/workspace-osa/przelewy24-dane", full.names = T, pattern = "zestaw")
for(file in files){
newData <- read.csv(file, sep="\t", skip=4,header=FALSE)
if(ncol(newData) == 1) {
stop(paste("Wrong separator in file", file))
}
newData <- newData %>% filter(!is.na(V1))
przelewy24 <- rbind.data.frame(przelewy24,newData)
}
names(przelewy24) <- c("L.p.", "ID.transakcji", "Data.przyjęcia", "Data.wpłaty", "Kwota.zł", "Klient", "Kraj", "Miasto", "Kod.pocztowy", "Adres", "E.mail", "Nr.paczki", "Forma.płatności", "Tytuł", "ID.sesji")
przelewy24$L.p. <- 1:nrow(przelewy24)
przelewy24 %>% mutate(Data=as.Date(Data.wpłaty)) %>%
mutate(DzienTygodnia = format(Data, "%u"), Tydzien = as.Date(cut(Data, "week")),
Miesiac=as.Date(cut(Data, "month")), Rok=format(Data, "%Y"), TydzienRoku=format(Data, "%V"),
Godzina = stri_sub(stri_extract_first_regex(ID.sesji, "\\d+:\\d+:\\d+"), 1, 2))-> przelewy24
# podsumowanie całkowite
przelewy24 %>% summarise(ile=length(Kwota.zł), suma=sum(Kwota.zł))
przelewy24 %>% group_by(Rok) %>% summarise(ile=length(Kwota.zł), suma=sum(Kwota.zł))
przelewy24 %>% group_by(DzienTygodnia) %>% summarise(ile=length(Kwota.zł), suma=sum(Kwota.zł)) %>%
ggplot(aes(x = DzienTygodnia)) + geom_col(aes(y = suma)) + expand_limits(y = 0) + ggtitle("Przychód według dnia tygodnia (1 - pon, 2 - wt, itd...)")
przelewy24 %>% group_by(Godzina) %>% summarise(ile=length(Kwota.zł), suma=sum(Kwota.zł)) %>%
ggplot(aes(x = Godzina)) + geom_col(aes(y = suma)) + ggtitle("Przychód według godziny")
# podsumowanie miesięczne
przelewy24 %>% group_by(Miesiac) %>% summarise(ile=length(Kwota.zł), suma=sum(Kwota.zł)) %>%  print(n=100)
przelewy24 %>% group_by(Forma.płatności) %>%
summarise(ile=length(Kwota.zł), suma=sum(Kwota.zł)) %>%
arrange(desc(suma), desc(ile)) %>%
print(n=100)
hist(przelewy24$Kwota.zł, breaks = 20)
przelewy24 %>% mutate(kwoty = trunc(Kwota.zł)) %>%  group_by(kwoty) %>%
summarise(count=length(kwoty), sum=sum(Kwota.zł)) %>% slice(1:5) -> ponizej5
sum(ponizej5[,3])
sum(ponizej5[,2])*5
print(n=100)
# klienci, którzy sprawdzili najwięcej prac
przelewy24 %>% group_by(E.mail) %>%
summarise(count = length(E.mail), total=sum(Kwota.zł)) %>%
arrange(desc(count), desc(total)) %>%
slice(1:20)
# klienci, którzy wydali najwięcej
przelewy24 %>% group_by(E.mail) %>%
summarise(count = length(E.mail), total=sum(Kwota.zł)) %>%
arrange(desc(total)) %>%
slice(1:20)
przelewy24 %>%
group_by(Data) %>% summarise(Total=sum(Kwota.zł)) %>%
complete(Data = seq.Date(min(Data), max(Data), by="day")) %>%
replace_na(list(Total = 0)) %>%
ggplot(aes(x = as.Date(Data), y = Total)) +
geom_line() + geom_point() +
geom_smooth(method = "loess") +
theme(axis.text.x = element_text(angle = 90)) +
scale_x_date(name = "Data", date_breaks = "1 week") +
scale_y_continuous(name = "Przychód (w zł)") +
ggtitle("OSA - zarobki")
zarobkiRocznie <- przelewy24 %>%
group_by(Tydzien) %>% summarise(Total=sum(Kwota.zł)) %>%
complete(Tydzien = seq.Date(min(Tydzien), max(Tydzien), by="week")) %>%
replace_na(list(Total = 0)) %>%
mutate(Rok = format(Tydzien, "%Y"), TydzienRoku = format(Tydzien, "%V")) %>%
ggplot(aes(x = TydzienRoku, y = Total, group = Rok, color=Rok, fill = Rok)) +
geom_line() + geom_point() +
theme(axis.text.x = element_text(angle = 90)) +
scale_y_continuous(name = "Przychód (w zł)") +
ggtitle("OSA - zarobki")
zarobkiRocznie
zarobkiRocznie + geom_smooth(method = "loess")
zarobkiRocznieNarastajaco <- przelewy24 %>%
group_by(Tydzien) %>% summarise(Total=sum(Kwota.zł)) %>%
# complete(Tydzien = seq.Date(min(Tydzien), max(Tydzien), by="week"), fill=list(Tydzien=0)) %>%
mutate(Rok = format(Tydzien, "%Y"), TydzienRoku = format(Tydzien, "%V")) %>%
group_by(Rok) %>% mutate(CumTotal=cumsum(Total)) %>%
replace_na(list(CumTotal = 0)) %>%
ggplot(aes(x = TydzienRoku, y = CumTotal, group = Rok, color=Rok, fill = Rok)) +
geom_line() + geom_point() +
theme(axis.text.x = element_text(angle = 90)) +
scale_y_continuous(name = "Przychód (w zł)") +
ggtitle("OSA - zarobki narastająco")
zarobkiRocznieNarastajaco
przelewy24 %>%
group_by(Data, Tydzien) %>% summarise(Count=length(Kwota.zł)) %>%
complete(Data = seq.Date(min(Tydzien), max(Tydzien), by="day")) %>%
replace_na(list(Count = 0)) %>%
group_by(Tydzien) %>% summarise(Count=sum(Count)) %>%
ggplot(aes(x = Tydzien, y = Count)) +
